@model List<TrainingSystem.Reporting.Models.CertificateViewModel>

@{
    ViewData["Title"] = "Certificates Report";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h2 class="fw-bold mb-1" style="color:#0a1f5c;">
                Certificates Report
            </h2>
            <p class="text-muted mb-0">
                View all issued certificates and trainee certification details.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Reports"
               asp-action="Index"
               class="btn px-4 py-2 fw-semibold"
               style="border:1px solid #0a1f5c; color:#0a1f5c; border-radius:12px;">
                ← Back to Reports
            </a>

            <a asp-action="ExportCertificates"
               class="btn px-4 py-2 fw-semibold text-white"
               style="background:#0a1f5c; border-radius:12px;">
                Export to Excel
            </a>
        </div>
    </div>

    <!-- Error Message -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger shadow-sm border-0 mb-4"
             style="border-radius:14px;">
            <strong>@ViewBag.Error</strong>

            @if (ViewBag.ErrorDetails != null)
            {
                <pre class="mt-2 mb-0"
                     style="white-space:pre-wrap;">@ViewBag.ErrorDetails</pre>
            }
        </div>
    }

    <!-- Report Card -->
    <div class="card border-0 shadow-sm"
         style="border-radius:20px; overflow:hidden;">

        <!-- Table Header -->
        <div class="card-header border-0 py-3 px-4"
             style="background:#0a1f5c;">
            <h5 class="text-white fw-semibold mb-0">
                Certificate Records
            </h5>
        </div>

        <!-- Table -->
        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead style="background:#f5f7fb;">
                    <tr>
                        <th class="py-3 px-4">Certificate ID</th>
                        <th class="py-3">Reference</th>
                        <th class="py-3">Trainee</th>
                        <th class="py-3">Track</th>
                        <th class="py-3">Status</th>
                        <th class="py-3">Issued Date</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var cert in Model)
                        {
                            <tr>

                                <td class="px-4 fw-semibold">
                                    #@cert.CertificateId
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark px-3 py-2"
                                          style="border-radius:10px;">
                                        @cert.CertificateReferenceNumber
                                    </span>
                                </td>

                                <td>
                                    @cert.TraineeName
                                </td>

                                <td>
                                    @cert.TrackName
                                </td>

                                <td>
                                    @if (cert.CertificateStatus == "Certified")
                                    {
                                        <span class="badge bg-success px-3 py-2"
                                              style="border-radius:10px;">
                                            Certified
                                        </span>
                                    }
                                    else if (cert.CertificateStatus == "Eligible")
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2"
                                              style="border-radius:10px;">
                                            Eligible
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2"
                                              style="border-radius:10px;">
                                            @cert.CertificateStatus
                                        </span>
                                    }
                                </td>

                                <td>
                                    @cert.IssuedDate
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                No certificate records found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>
</div>