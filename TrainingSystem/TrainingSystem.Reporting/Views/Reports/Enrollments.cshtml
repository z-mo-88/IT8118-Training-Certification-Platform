@model List<TrainingSystem.Reporting.Models.EnrollmentViewModel>

@{
    ViewData["Title"] = "Enrollments Report";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h2 class="fw-bold mb-1" style="color:#0a1f5c;">
                Enrollments Report
            </h2>
            <p class="text-muted mb-0">
                View trainee enrollments, course participation, and payment balances.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Reports"
               asp-action="Index"
               class="btn px-4 py-2 fw-semibold"
               style="border:1px solid #0a1f5c; color:#0a1f5c; border-radius:12px;">
                ← Back to Reports
            </a>

            <a asp-action="ExportEnrollments"
               class="btn px-4 py-2 fw-semibold text-white"
               style="background:#0a1f5c; border-radius:12px;">
                Export to Excel
            </a>
        </div>
    </div>

    <!-- Error Message -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger shadow-sm border-0 mb-4"
             style="border-radius:14px;">

            <strong>@ViewBag.Error</strong>

            @if (ViewBag.ErrorDetails != null)
            {
                <pre class="mt-2 mb-0"
                     style="white-space:pre-wrap;">@ViewBag.ErrorDetails</pre>
            }

        </div>
    }

    <!-- Report Card -->
    <div class="card border-0 shadow-sm"
         style="border-radius:20px; overflow:hidden;">

        <!-- Card Header -->
        <div class="card-header border-0 py-3 px-4"
             style="background:#0a1f5c;">

            <h5 class="text-white fw-semibold mb-0">
                Enrollment Records
            </h5>

        </div>

        <!-- Table -->
        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead style="background:#f5f7fb;">
                    <tr>
                        <th class="py-3 px-4">Enrollment ID</th>
                        <th class="py-3">Trainee</th>
                        <th class="py-3">Course</th>
                        <th class="py-3">Status</th>
                        <th class="py-3">Enrollment Date</th>
                        <th class="py-3">Outstanding Balance</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var enrollment in Model)
                        {
                            <tr>

                                <td class="px-4 fw-semibold">
                                    #@enrollment.EnrollmentId
                                </td>

                                <td>
                                    @enrollment.TraineeName
                                </td>

                                <td>
                                    <span class="fw-semibold">
                                        @enrollment.CourseTitle
                                    </span>
                                </td>

                                <td>

                                    @if (enrollment.Status == "Completed")
                                    {
                                        <span class="badge bg-success px-3 py-2"
                                              style="border-radius:10px;">
                                            Completed
                                        </span>
                                    }
                                    else if (enrollment.Status == "Confirmed")
                                    {
                                        <span class="badge bg-primary px-3 py-2"
                                              style="border-radius:10px;">
                                            Confirmed
                                        </span>
                                    }
                                    else if (enrollment.Status == "Attending")
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2"
                                              style="border-radius:10px;">
                                            Attending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2"
                                              style="border-radius:10px;">
                                            @enrollment.Status
                                        </span>
                                    }

                                </td>

                                <td>
                                    @enrollment.EnrollmentDate
                                </td>

                                <td>

                                    @if (enrollment.OutstandingBalance > 0)
                                    {
                                        <span class="badge bg-danger px-3 py-2"
                                              style="border-radius:10px;">
                                            @enrollment.OutstandingBalance BD
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success px-3 py-2"
                                              style="border-radius:10px;">
                                            Paid
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center py-5 text-muted">
                                No enrollment records found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>