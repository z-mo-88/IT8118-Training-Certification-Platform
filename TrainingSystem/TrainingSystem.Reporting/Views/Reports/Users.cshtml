@model List<TrainingSystem.Reporting.Models.UserViewModel>

@{
    ViewData["Title"] = "Users Report";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h2 class="fw-bold mb-1" style="color:#0a1f5c;">
                Users Report
            </h2>
            <p class="text-muted mb-0">
                View all registered users and assigned system roles.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Reports"
               asp-action="Index"
               class="btn px-4 py-2 fw-semibold"
               style="border:1px solid #0a1f5c; color:#0a1f5c; border-radius:12px;">
                ← Back to Reports
            </a>

            <a asp-action="ExportUsers"
               class="btn px-4 py-2 fw-semibold text-white"
               style="background:#0a1f5c; border-radius:12px;">
                Export to Excel
            </a>
        </div>
    </div>

    <!-- Error -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger shadow-sm border-0 mb-4"
             style="border-radius:14px;">

            <strong>@ViewBag.Error</strong>

        </div>
    }

    <!-- Card -->
    <div class="card border-0 shadow-sm"
         style="border-radius:20px; overflow:hidden;">

        <!-- Card Header -->
        <div class="card-header border-0 py-3 px-4"
             style="background:#0a1f5c;">

            <h5 class="text-white fw-semibold mb-0">
                User Records
            </h5>

        </div>

        <!-- Table -->
        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead style="background:#f5f7fb;">
                    <tr>
                        <th class="py-3 px-4">User ID</th>
                        <th class="py-3">Name</th>
                        <th class="py-3">Email</th>
                        <th class="py-3">Phone</th>
                        <th class="py-3">Role</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            <tr>

                                <td class="px-4 fw-semibold">
                                    #@user.UserId
                                </td>

                                <td>
                                    <span class="fw-semibold">
                                        @user.Name
                                    </span>
                                </td>

                                <td>
                                    <span class="text-muted">
                                        @user.Email
                                    </span>
                                </td>

                                <td>
                                    @user.PhoneNumber
                                </td>

                                <td>

                                    @if (user.RoleId == 1)
                                    {
                                        <span class="badge bg-primary px-3 py-2"
                                              style="border-radius:10px;">
                                            Trainee
                                        </span>
                                    }
                                    else if (user.RoleId == 2)
                                    {
                                        <span class="badge bg-success px-3 py-2"
                                              style="border-radius:10px;">
                                            Instructor
                                        </span>
                                    }
                                    else if (user.RoleId == 3)
                                    {
                                        <span class="badge bg-dark px-3 py-2"
                                              style="border-radius:10px;">
                                            Coordinator
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2"
                                              style="border-radius:10px;">
                                            Unknown
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5"
                                class="text-center py-5 text-muted">
                                No user records found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>