@model List<TrainingSystem.Reporting.Models.CourseViewModel>

@{
    ViewData["Title"] = "Courses Report";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h2 class="fw-bold mb-1" style="color:#0a1f5c;">
                Courses Report
            </h2>
            <p class="text-muted mb-0">
                View all available training courses and course duration details.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Reports"
               asp-action="Index"
               class="btn px-4 py-2 fw-semibold"
               style="border:1px solid #0a1f5c; color:#0a1f5c; border-radius:12px;">
                ← Back to Reports
            </a>

            <a asp-action="ExportCourses"
               class="btn px-4 py-2 fw-semibold text-white"
               style="background:#0a1f5c; border-radius:12px;">
                Export to Excel
            </a>
        </div>
    </div>

    <!-- Error Message -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger shadow-sm border-0 mb-4"
             style="border-radius:14px;">
            <strong>@ViewBag.Error</strong>

            @if (ViewBag.ErrorDetails != null)
            {
                <pre class="mt-2 mb-0"
                     style="white-space:pre-wrap;">@ViewBag.ErrorDetails</pre>
            }
        </div>
    }

    <!-- Report Card -->
    <div class="card border-0 shadow-sm"
         style="border-radius:20px; overflow:hidden;">

        <!-- Card Header -->
        <div class="card-header border-0 py-3 px-4"
             style="background:#0a1f5c;">

            <h5 class="text-white fw-semibold mb-0">
                Course Records
            </h5>

        </div>

        <!-- Table -->
        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead style="background:#f5f7fb;">
                    <tr>
                        <th class="py-3 px-4">Course ID</th>
                        <th class="py-3">Title</th>
                        <th class="py-3">Description</th>
                        <th class="py-3">Duration</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var course in Model)
                        {
                            <tr>

                                <td class="px-4 fw-semibold">
                                    #@course.CourseId
                                </td>

                                <td>
                                    <span class="fw-semibold">
                                        @course.Title
                                    </span>
                                </td>

                                <td style="max-width:400px;">
                                    <span class="text-muted">
                                        @course.Description
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-primary px-3 py-2"
                                          style="border-radius:10px;">
                                        @course.DurationHours Hours
                                    </span>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4"
                                class="text-center py-5 text-muted">
                                No course records found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>