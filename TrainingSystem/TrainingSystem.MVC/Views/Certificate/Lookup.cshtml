@using System.Collections
@{
    ViewData["Title"] = "Certificate Lookup";

    var completedCourses = ViewBag.CompletedCourses as IEnumerable;
}

<div class="container-fluid py-5 px-3 px-md-5"
     style="background-color:#f6f8fc; min-height:100vh;">

    <div class="row justify-content-center">

        <div class="col-12 col-xl-10">

            <!-- SEARCH CARD -->
            <div class="card border-0 shadow-sm mb-4"
                 style="border-radius:22px;
                        overflow:hidden;
                        background-color:white;">

                <!-- TOP BAR -->
                <div class="px-4 py-3 text-white"
                     style="background: linear-gradient(135deg, #0a1f5c, #163d99);">

                    <h4 class="fw-bold mb-1">
                        Certificate Lookup
                    </h4>

                    <small class="text-white-50">
                        Search for a certificate using CPR and certificate reference.
                    </small>

                </div>

                <!-- BODY -->
                <div class="card-body p-4 p-lg-5">

                    <form method="post">

                        <div class="row">

                            <!-- CPR -->
                            <div class="col-md-6 mb-4">

                                <label class="form-label fw-semibold"
                                       style="color:#0a1f5c;">

                                    CPR

                                </label>

                                <input name="cpr"
                                       type="text"
                                       required
                                       class="form-control"
                                       placeholder="Enter CPR"
                                       value="@(ViewBag.SearchedCPR ?? "")"
                                       style="height:50px;
                                              border-radius:12px;
                                              border:1px solid #dfe5f1;" />

                            </div>

                            <!-- REFERENCE -->
                            <div class="col-md-6 mb-4">

                                <label class="form-label fw-semibold"
                                       style="color:#0a1f5c;">

                                    Certificate Reference

                                </label>

                                <input name="reference"
                                       required
                                       class="form-control"
                                       placeholder="Enter reference number"
                                       value="@(ViewBag.SearchedReference ?? "")"
                                       style="height:50px;
                                              border-radius:12px;
                                              border:1px solid #dfe5f1;" />

                            </div>

                        </div>

                        <!-- BUTTON -->
                        <button type="submit"
                                class="btn text-white fw-semibold px-5 d-inline-flex align-items-center justify-content-center shadow-sm"
                                style="background-color:#0a1f5c;
                                       height:48px;
                                       border-radius:12px;
                                       border:none;
                                       font-size:0.9rem;">

                            Search

                        </button>

                    </form>

                    <!-- ERROR -->
                    @if (ViewBag.ResultMessage != null)
                    {
                        <div class="alert alert-danger border-0 shadow-sm mt-4"
                             style="border-radius:14px;">

                            @ViewBag.ResultMessage

                        </div>
                    }

                </div>

            </div>

            <!-- CERTIFICATE DETAILS -->
            @if (ViewBag.CertificateId != null)
            {
                <div class="card border-0 shadow-sm"
                     style="border-radius:22px;
                                overflow:hidden;
                                background-color:white;">

                    <!-- TOP BAR -->
                    <div class="px-4 py-3 text-white"
                         style="background: linear-gradient(135deg, #0a1f5c, #163d99);">

                        <h4 class="fw-bold mb-1">
                            Certificate Details
                        </h4>

                        <small class="text-white-50">
                            Certificate and completed course information.
                        </small>

                    </div>

                    <!-- BODY -->
                    <div class="card-body p-4 p-lg-5">

                        <!-- INFO GRID -->
                        <div class="row g-4 mb-2">

                            <!-- TRAINEE -->
                            <div class="col-md-3">

                                <div class="small fw-semibold mb-1"
                                     style="color:#0a1f5c;">

                                    Trainee Name

                                </div>

                                <div class="text-muted">

                                    @ViewBag.TraineeName

                                </div>

                            </div>

                            <!-- CPR -->
                            <div class="col-md-2">

                                <div class="small fw-semibold mb-1"
                                     style="color:#0a1f5c;">

                                    CPR

                                </div>

                                <div class="text-muted">

                                    @ViewBag.CPR

                                </div>

                            </div>

                            <!-- REFERENCE -->
                            <div class="col-md-3">

                                <div class="small fw-semibold mb-1"
                                     style="color:#0a1f5c;">

                                    Reference

                                </div>

                                <div class="text-muted">

                                    @ViewBag.CertificateReferenceNumber

                                </div>

                            </div>

                            <!-- STATUS -->
                            <div class="col-md-2">

                                <div class="small fw-semibold mb-1"
                                     style="color:#0a1f5c;">

                                    Status

                                </div>

                                <div>

                                    @{
                                        var status = ViewBag.CertificateStatus as string;

                                        string badgeColor = status switch
                                        {
                                            "Certified" => "background-color:#e7f8ee; color:#198754;",
                                            "Eligible" => "background-color:#fff3cd; color:#856404;",
                                            "In Progress" => "background-color:#e7f1ff; color:#0d6efd;",
                                            _ => "background-color:rgba(10,31,92,0.08); color:#0a1f5c;"
                                        };
                                    }

                                    <span class="badge rounded-pill px-3 py-2"
                                          style="@badgeColor
                                                     font-size:0.75rem;
                                                     font-weight:600;">

                                        @status

                                    </span>

                                </div>

                            </div>

                            <!-- DATE -->
                            <div class="col-md-2">

                                <div class="small fw-semibold mb-1"
                                     style="color:#0a1f5c;">

                                    Issued Date

                                </div>

                                <div class="text-muted">

                                    @ViewBag.IssuedDate

                                </div>

                            </div>

                            <!-- TRACK -->
                            <div class="col-md-3">

                                <div class="small fw-semibold mb-1"
                                     style="color:#0a1f5c;">

                                    Track

                                </div>

                                <div class="text-muted">

                                    @ViewBag.TrackName

                                </div>

                            </div>

                        </div>

                        <hr class="my-4" />

                        <!-- COURSES -->
                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <h5 class="fw-bold mb-0"
                                style="color:#0a1f5c;">

                                Completed Courses

                            </h5>

                        </div>

                        @if (completedCourses != null)
                        {
                            <div class="row">

                                @{
                                    bool hasCourses = false;
                                }

                                @foreach (var course in completedCourses)
                                {
                                    hasCourses = true;

                                    <div class="col-md-6 col-lg-4 mb-3">

                                        <div class="h-100 p-4"
                                             style="border:1px solid rgba(10,31,92,0.08);
                                                                border-radius:18px;
                                                                background-color:#fbfcff;">

                                            <!-- TITLE -->
                                            <div class="fw-bold mb-2"
                                                 style="color:#0a1f5c;
                                                                    font-size:0.95rem;">

                                                @course.GetType().GetProperty("Title")?.GetValue(course, null)

                                            </div>

                                            <!-- STATUS -->
                                            @if (course.GetType().GetProperty("IsRequired") != null)
                                            {
                                                var isRequired =
                                                course.GetType().GetProperty("IsRequired")
                                                ?.GetValue(course, null);

                                                <span class="badge rounded-pill px-3 py-2"
                                                      style="background-color:@((isRequired != null && (bool)isRequired) ? "#e7f8ee" : "#eef1f6");
                                                                             color:@((isRequired != null && (bool)isRequired) ? "#198754" : "#6c757d");
                                                                             font-size:0.75rem;
                                                                             font-weight:600;">

                                                    @(isRequired != null && (bool)isRequired
                                                                                        ? "Required"
                                                                                        : "Optional")

                                </span>
                                                                }

                                        </div>

                                    </div>
                                }

                                @if (!hasCourses)
                                {
                                    <div class="col-12">

                                        <div class="text-muted">

                                            No completed courses found.

                                        </div>

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="text-muted">

                                No completed courses found.

                            </div>
                        }

                    </div>

                </div>
            }

        </div>

    </div>

</div>