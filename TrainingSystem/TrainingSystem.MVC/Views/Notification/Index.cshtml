@model IEnumerable<TrainingSystem.API.Models.Notification>

@{
    ViewData["Title"] = "My Notifications";
}

<div class="container-fluid py-5 px-3 px-md-5">

    <!-- Header -->
    <div class="text-center mb-4">

        <h2 class="fw-bold mb-2"
            style="color: #0a1f5c;">
            My Notifications
        </h2>

        <p class="text-muted mb-0">
            Stay updated with your latest alerts and messages.
        </p>

    </div>

    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm"
             style="border-radius: 12px;">

            @TempData["Success"]

        </div>
    }

    <!-- Card -->
    <div class="card border-0 shadow-sm overflow-hidden"
         style="border-radius: 22px;">

        <!-- Top Bar -->
        <div class="px-4 py-3 text-white"
             style="background: linear-gradient(135deg, #0a1f5c, #123a9c);">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <div>

                    <h5 class="fw-bold mb-1">
                        Notifications List
                    </h5>

                    <small class="text-white-50">
                        Total Notifications:
                        @(Model?.Count() ?? 0)
                    </small>

                </div>

                <div class="px-3 py-2 rounded-pill"
                     style="background: rgba(255,255,255,0.12);">

                    <small>
                        Notification Center
                    </small>

                </div>

            </div>

        </div>

        <!-- Table -->
        <div class="card-body p-0"
             style="background-color:#f8faff;">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead style="background-color: rgba(10, 31, 92, 0.05);">

                        <tr>

                            <th class="fw-semibold px-4 py-3"
                                style="color: #0a1f5c;">
                                Message
                            </th>

                            <th class="fw-semibold py-3"
                                style="color: #0a1f5c;">
                                Date
                            </th>

                            <th class="fw-semibold py-3"
                                style="color: #0a1f5c;">
                                Status
                            </th>

                            <th class="fw-semibold py-3 text-center"
                                style="color: #0a1f5c; width: 260px;">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr style="border-bottom: 1px solid #eef2f7;
                                                   background-color:@(item.IsRead ? "white" : "#fffaf0");">

                                    <!-- MESSAGE -->
                                    <td class="px-4 py-4 @(item.IsRead ? "text-muted" : "fw-semibold")">

                                        @item.Message

                                    </td>

                                    <!-- DATE -->
                                    <td class="py-3 text-muted">

                                        @item.CreatedAt.ToShortDateString()

                                    </td>

                                    <!-- STATUS -->
                                    <td class="py-3">

                                        @if (item.IsRead)
                                        {
                                            <span class="badge rounded-pill px-3 py-2 bg-success">
                                                Read
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill px-3 py-2 bg-danger">
                                                Unread
                                            </span>
                                        }

                                    </td>

                                    <!-- ACTIONS -->
                                    <td class="text-center py-3">

                                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                                            @if (!item.IsRead)
                                            {
                                                <form asp-action="MarkAsRead"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@item.NotificationId" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-primary fw-semibold px-3"
                                                            style="border-radius: 10px;">

                                                        Mark as Read

                                                    </button>

                                                </form>
                                            }

                                            <form asp-action="Delete"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.NotificationId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger fw-semibold px-3"
                                                        style="border-radius: 10px;">

                                                    Delete

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="4"
                                    class="text-center text-muted py-5">

                                    No notifications found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>