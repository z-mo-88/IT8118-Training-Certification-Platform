@model IEnumerable<TrainingSystem.API.Models.CourseEquipmentRequirement>

@{
    ViewData["Title"] = "Course Equipment Requirements";
}

<div class="container-fluid py-5 px-3 px-md-5"
     style="background-color:#f6f8fc; min-height:100vh;">

    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

        <div>

            <h2 class="fw-bold mb-1"
                style="color:#0a1f5c;">

                Course Equipment Requirements

            </h2>

            <p class="text-muted mb-0">
                Manage the equipment required for each course.
            </p>

        </div>

        <div class="mt-3 mt-md-0">

            <a asp-action="Create"
               class="btn text-white fw-semibold px-4 d-inline-flex align-items-center justify-content-center shadow-sm"
               style="background-color:#0a1f5c;
                      border-radius:12px;
                      border:none;
                      height:46px;
                      font-size:0.9rem;">

                Add Requirement

            </a>

        </div>

    </div>

    <!-- SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4"
             style="border-radius:14px;">

            @TempData["Success"]

        </div>
    }

    <!-- CARD -->
    <div class="card border-0 shadow-sm"
         style="border-radius:22px;
                overflow:hidden;
                background-color:white;">

        <!-- TOP BAR -->
        <div class="px-4 py-3 text-white"
             style="background: linear-gradient(135deg, #0a1f5c, #163d99);">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <div>

                    <h5 class="fw-bold mb-1">
                        Equipment Requirements
                    </h5>

                    <small class="text-white-50">
                        Total Records:
                        @(Model?.Count() ?? 0)
                    </small>

                </div>

            </div>

        </div>

        <!-- TABLE -->
        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle mb-0"
                       style="font-size:0.92rem;">

                    <thead style="background-color:rgba(10,31,92,0.05);">

                        <tr>

                            <th class="fw-bold px-4 py-3"
                                style="color:#0a1f5c;">
                                Course
                            </th>

                            <th class="fw-bold py-3"
                                style="color:#0a1f5c;">
                                Equipment
                            </th>

                            <th class="fw-bold py-3"
                                style="color:#0a1f5c;">
                                Quantity Required
                            </th>

                            <th class="fw-bold py-3 text-center"
                                style="color:#0a1f5c;
                                       width:180px;">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr style="vertical-align:middle;">

                                    <!-- COURSE -->
                                    <td class="px-4 py-3 fw-semibold"
                                        style="color:#0a1f5c;">

                                        @item.Course?.Title

                                    </td>

                                    <!-- EQUIPMENT -->
                                    <td class="py-3 text-muted">

                                        @item.Equipment?.EquipmentName

                                    </td>

                                    <!-- QUANTITY -->
                                    <td class="py-3">

                                        <span class="badge rounded-pill px-3 py-2"
                                              style="background-color:rgba(10,31,92,0.08);
                                                             color:#0a1f5c;
                                                             font-size:0.75rem;">

                                            @item.QuantityRequired

                                        </span>

                                    </td>

                                    <!-- ACTIONS -->
                                    <td class="py-3 text-center">

                                        <form asp-action="Delete"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.CourseEquipmentRequirementId" />

                                            <button type="submit"
                                                    class="btn btn-sm fw-semibold text-white px-3"
                                                    style="background-color:#dc3545;
                                                                   border-radius:10px;
                                                                   border:none;
                                                                   min-width:90px;
                                                                   font-size:0.78rem;"
                                                    onclick="return confirm('Are you sure you want to delete this requirement?');">

                                                Delete

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="4"
                                    class="text-center text-muted py-5">

                                    No course equipment requirements found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>