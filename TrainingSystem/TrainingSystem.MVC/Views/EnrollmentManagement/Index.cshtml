
@model IEnumerable<TrainingSystem.API.Models.Enrollment>

@{
    ViewData["Title"] = "Enrollment Management";
}

<div class="container-fluid py-5 px-3 px-md-5"
     style="background-color:#f6f8fc; min-height:100vh;">

    <!-- HEADER -->
    <div class="mb-4">

        <h2 class="fw-bold mb-1"
            style="color:#0a1f5c;">

            Enrollment Management

        </h2>

        <p class="text-muted mb-0">
            Manage trainee enrollments and lifecycle status.
        </p>

    </div>

    <!-- SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4"
             style="border-radius:14px;">

            @TempData["Success"]

        </div>
    }

    <!-- ERROR -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4"
             style="border-radius:14px;">

            @TempData["Error"]

        </div>
    }

    <!-- CARD -->
    <div class="card border-0 shadow-sm"
         style="border-radius:22px;
                overflow:hidden;
                background-color:white;">

        <!-- TOP BAR -->
        <div class="px-4 py-3 text-white"
             style="background: linear-gradient(135deg, #0a1f5c, #163d99);">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <div>

                    <h5 class="fw-bold mb-1">
                        Enrollment Records
                    </h5>

                    <small class="text-white-50">
                        Total Enrollments:
                        @(Model?.Count() ?? 0)
                    </small>

                </div>

            </div>

        </div>

        <!-- TABLE -->
        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle mb-0"
                       style="font-size:0.92rem;">

                    <thead style="background-color:rgba(10,31,92,0.05);">

                        <tr>

                            <th class="fw-bold px-4 py-3"
                                style="color:#0a1f5c;">
                                Trainee
                            </th>

                            <th class="fw-bold py-3"
                                style="color:#0a1f5c;">
                                CPR
                            </th>

                            <th class="fw-bold py-3"
                                style="color:#0a1f5c;">
                                Course
                            </th>

                            <th class="fw-bold py-3"
                                style="color:#0a1f5c;">
                                Session Date
                            </th>

                            <th class="fw-bold py-3 text-center"
                                style="color:#0a1f5c;">
                                Status
                            </th>

                            <th class="fw-bold py-3 text-center"
                                style="color:#0a1f5c;">
                                Balance
                            </th>

                            <th class="fw-bold py-3 text-center"
                                style="color:#0a1f5c; min-width:180px;">
                                Payment
                            </th>

                            <th class="fw-bold py-3 text-center"
                                style="color:#0a1f5c; min-width:220px;">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                var isPaid = item.OutstandingBalance <= 0;

                                string statusStyle = item.Status switch
                                {
                                    "Completed" => "background-color:#e7f8ee; color:#198754;",
                                    "Dropped" => "background-color:#ffe5e5; color:#dc3545;",
                                    "Confirmed" => "background-color:#e7f1ff; color:#0d6efd;",
                                    "Attending" => "background-color:#e8fffa; color:#20c997;",
                                    _ => "background-color:rgba(10,31,92,0.08); color:#0a1f5c;"
                                };

                                <tr style="vertical-align:middle;">

                                    <!-- TRAINEE -->
                                    <td class="px-4 py-3 fw-semibold"
                                        style="color:#0a1f5c;">

                                        @item.User?.Name

                                    </td>

                                    <!-- CPR -->
                                    <td class="py-3 text-muted">

                                        @item.User?.CPR

                                    </td>

                                    <!-- COURSE -->
                                    <td class="py-3 text-muted">

                                        @item.Session?.Course?.Title

                                    </td>

                                    <!-- SESSION DATE -->
                                    <td class="py-3 text-muted">

                                        @item.Session?.SessionDate.ToShortDateString()

                                    </td>

                                    <!-- STATUS -->
                                    <td class="py-3 text-center">

                                        <span class="badge rounded-pill px-3 py-2"
                                              style="@statusStyle
                                                             font-size:0.75rem;
                                                             font-weight:600;">

                                            @item.Status

                                        </span>

                                    </td>

                                    <!-- BALANCE -->
                                    <td class="py-3 text-center fw-bold"
                                        style="color:@(item.OutstandingBalance > 0 ? "#dc3545" : "#198754")">

                                        @item.OutstandingBalance

                                    </td>

                                    <!-- PAYMENT -->
                                    <td class="py-3 text-center"
                                        style="min-width:180px;">

                                        @if (isPaid)
                                        {
                                            <span class="badge rounded-pill px-3 py-2"
                                                  style="background-color:#e7f8ee;
                                                                     color:#198754;
                                                                     font-size:0.75rem;
                                                                     font-weight:600;">

                                                Paid

                                            </span>
                                        }
                                        else if (item.OutstandingBalance > 0 &&
                                        item.Session.SessionDate < DateOnly.FromDateTime(DateTime.Now))
                                        {
                                            <span class="badge rounded-pill px-3 py-2"
                                                  style="background-color:#ffe5e5;
                                                                     color:#dc3545;
                                                                     font-size:0.75rem;
                                                                     font-weight:600;">

                                                Overdue

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill px-3 py-2"
                                                  style="background-color:#fff3cd;
                                                                     color:#856404;
                                                                     font-size:0.75rem;
                                                                     font-weight:600;">

                                                Partial / Unpaid

                                            </span>
                                        }

                                    </td>

                                    <!-- ACTIONS -->
                                    <td class="py-3 text-center"
                                        style="min-width:220px;">

                                        @if (item.Status == "Enrolled" && isPaid)
                                        {
                                            <form asp-action="Confirm"
                                                  method="post"
                                                  style="display:inline;">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.EnrollmentId" />

                                                <button type="submit"
                                                        class="btn btn-sm fw-semibold text-white px-3"
                                                        style="background-color:#0d6efd;
                                                                           border-radius:10px;
                                                                           border:none;
                                                                           min-width:110px;
                                                                           font-size:0.78rem;">

                                                    Confirm

                                                </button>

                                            </form>
                                        }
                                        else if (item.Status == "Confirmed")
                                        {
                                            <form asp-action="MarkAttending"
                                                  method="post"
                                                  style="display:inline;">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.EnrollmentId" />

                                                <button type="submit"
                                                        class="btn btn-sm fw-semibold text-white px-3"
                                                        style="background-color:#20c997;
                                                                           border-radius:10px;
                                                                           border:none;
                                                                           min-width:140px;
                                                                           font-size:0.78rem;">

                                                    Mark Attending

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center text-muted py-5">

                                    No enrollments found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>