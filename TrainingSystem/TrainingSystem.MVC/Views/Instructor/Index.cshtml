@model IEnumerable<TrainingSystem.MVC.Models.InstructorDisplayViewModel>

@{
    ViewData["Title"] = "Instructors";
}

<div class="container-fluid py-5 px-3 px-md-5">

    <div class="mb-4">

        <h2 class="fw-bold mb-1"
            style="color: #0a1f5c;">

            Instructors

        </h2>

        <p class="text-muted mb-0">
            View and manage instructor information, expertise, and availability.
        </p>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm"
             style="border-radius: 12px;">

            @TempData["Success"]

        </div>
    }

    <div class="card border-0 shadow-sm"
         style="border-radius: 18px; overflow:hidden;">

        <!-- TOP BAR -->
        <div class="px-4 py-3 text-white"
             style="background: linear-gradient(135deg, #0a1f5c, #123a9c);">

            <h5 class="fw-bold mb-1">
                Instructor List
            </h5>

            <small class="text-white-50">
                Total Instructors:
                @(Model?.Count() ?? 0)
            </small>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle mb-0"
                       style="font-size: 0.92rem;">

                    <thead style="background-color: rgba(10, 31, 92, 0.06);">

                        <tr>

                            <th class="px-4 py-3 small fw-bold">
                                Name
                            </th>

                            <th class="small fw-bold">
                                Email
                            </th>

                            <th class="small fw-bold">
                                Phone
                            </th>

                            <th class="small fw-bold">
                                Expertise
                            </th>

                            <th class="small fw-bold">
                                Availability
                            </th>

                            <th class="small fw-bold">
                                Bio
                            </th>

                            <th class="small fw-bold">
                                Notes
                            </th>

                            <th class="text-center small fw-bold">
                                Status
                            </th>

                            <th class="text-center small fw-bold">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr style="vertical-align: middle;">

                                    <!-- NAME -->
                                    <td class="px-4 py-3 fw-semibold small"
                                        style="color:#0a1f5c;">

                                        @item.Name

                                    </td>

                                    <!-- EMAIL -->
                                    <td class="text-muted small">

                                        @item.Email

                                    </td>

                                    <!-- PHONE -->
                                    <td class="text-muted small">

                                        @item.PhoneNumber

                                    </td>

                                    <!-- EXPERTISE -->
                                    <td>

                                        @if (item.ExpertiseNames.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1">

                                                @foreach (var exp in item.ExpertiseNames)
                                                {
                                                    <span class="badge bg-light text-dark px-2 py-1"
                                                          style="font-size: 0.72rem;">

                                                        @exp

                                                    </span>
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                -
                                            </span>
                                        }

                                    </td>

                                    <!-- AVAILABILITY -->
                                    <td>

                                        @if (item.AvailabilityText.Any())
                                        {
                                            <ul class="mb-0 ps-3 text-muted small">

                                                @foreach (var a in item.AvailabilityText.Take(2))
                                                {
                                                    <li>@a</li>
                                                }

                                            </ul>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                -
                                            </span>
                                        }

                                    </td>

                                    <!-- BIO -->
                                    <td class="text-muted small"
                                        style="font-size:0.82rem;
                                                       line-height:1.45;
                                                       max-width:220px;
                                                       white-space:normal;">

                                        @item.Bio

                                    </td>

                                    <!-- NOTES -->
                                    <td class="text-muted small"
                                        style="font-size:0.82rem;
                                                       line-height:1.45;
                                                       max-width:200px;
                                                       white-space:normal;">

                                        @item.Notes

                                    </td>

                                    <!-- STATUS -->
                                    <td class="text-center">

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success px-3 py-2"
                                                  style="font-size: 0.72rem; border-radius: 999px;">

                                                Active

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2"
                                                  style="font-size: 0.72rem; border-radius: 999px;">

                                                Inactive

                                            </span>
                                        }

                                    </td>

                                    <!-- ACTIONS -->
                                    <td class="text-center">

                                        <div class="d-flex flex-column gap-2 align-items-center">

                                            <a href="/InstructorExpertise?userId=@item.UserId"
                                               class="btn btn-sm fw-semibold text-white px-3"
                                               style="background-color:#0a1f5c;
                                                              border-radius:10px;
                                                              border:none;
                                                              min-width:115px;
                                                              font-size:0.78rem;">

                                                Edit Expertise

                                            </a>

                                            <a href="/InstructorAvailability?userId=@item.UserId"
                                               class="btn btn-sm fw-semibold text-white px-3"
                                               style="background-color:#20c997;
                                                              border-radius:10px;
                                                              border:none;
                                                              min-width:115px;
                                                              font-size:0.78rem;">

                                                Edit Availability

                                            </a>

                                            <form asp-action="ToggleStatus"
                                                  method="post"
                                                  style="display:inline;">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.UserId" />

                                                <button type="submit"
                                                        class="btn btn-sm fw-semibold text-white px-3"
                                                        style="background-color:@(item.IsActive ? "#dc3545" : "#198754");
                                                                       border-radius:10px;
                                                                       border:none;
                                                                       min-width:115px;
                                                                       font-size:0.78rem;">

                                                    @(item.IsActive ? "Deactivate" : "Activate")

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="9"
                                    class="text-center text-muted py-5">

                                    No instructors found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>