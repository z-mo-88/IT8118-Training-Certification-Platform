@model IEnumerable<TrainingSystem.API.Models.SubjectCategory>

<div class="container-fluid py-5 px-3 px-md-5"
     style="background-color:#f6f8fc; min-height:100vh;">

    <!-- HEADER -->
    <div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center">

        <div>

            <h2 class="fw-bold mb-1"
                style="color:#0a1f5c;">

                Categories

            </h2>

            <p class="text-muted mb-0">
                Manage course categories.
            </p>

        </div>

        <div class="mt-3 mt-md-0">

            <a asp-action="Create"
               class="btn text-white fw-semibold px-4 d-inline-flex align-items-center justify-content-center shadow-sm"
               style="background-color:#0a1f5c;
                      border-radius:12px;
                      border:none;
                      height:46px;
                      font-size:0.9rem;">

                + Add Category

            </a>

        </div>

    </div>

    <!-- SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4"
             style="border-radius:14px;">

            @TempData["Success"]

        </div>
    }

    <!-- ERROR -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4"
             style="border-radius:14px;">

            @TempData["Error"]

        </div>
    }

    <!-- CARD -->
    <div class="card border-0 shadow-sm"
         style="border-radius:22px;
                overflow:hidden;
                background-color:white;">

        <!-- TOP BAR -->
        <div class="px-4 py-3 text-white"
             style="background: linear-gradient(135deg, #0a1f5c, #163d99);">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <div>

                    <h5 class="fw-bold mb-1">
                        Category List
                    </h5>

                    <small class="text-white-50">
                        Total Categories:
                        @(Model?.Count() ?? 0)
                    </small>

                </div>

            </div>

        </div>

        <!-- BODY -->
        <div class="card-body p-4">

            @if (Model != null && Model.Any())
            {
                @foreach (var c in Model)
                {
                    <div class="mb-3 p-4"
                         style="border:1px solid rgba(10,31,92,0.08);
                                        border-radius:18px;
                                        background-color:#fbfcff;">

                        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                            <!-- LEFT -->
                            <div>

                                <div class="fw-bold mb-2"
                                     style="color:#0a1f5c;
                                                    font-size:1rem;">

                                    @c.CategoryName

                                </div>

                                <div class="text-muted"
                                     style="font-size:0.9rem;
                                                    line-height:1.5;
                                                    max-width:700px;">

                                    @c.Description

                                </div>

                            </div>

                            <!-- BUTTONS -->
                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-action="Edit"
                                   asp-route-id="@c.CategoryId"
                                   class="btn btn-sm fw-semibold px-3 d-inline-flex align-items-center justify-content-center"
                                   style="background:#ffc107;
                                                  border-radius:10px;
                                                  border:none;
                                                  min-width:80px;
                                                  font-size:0.78rem;
                                                  color:#212529;">

                                    Edit

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@c.CategoryId"
                                   class="btn btn-sm text-white fw-semibold px-3 d-inline-flex align-items-center justify-content-center"
                                   style="background:#dc3545;
                                                  border-radius:10px;
                                                  border:none;
                                                  min-width:80px;
                                                  font-size:0.78rem;">

                                    Delete

                                </a>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 text-muted">

                    No categories found.

                </div>
            }

        </div>

    </div>

</div>