@model TrainingSystem.API.Models.Provider

@{
    ViewData["Title"] = "Edit Provider";
}

<div class="container-fluid py-5 px-3 px-md-5">

    <div class="mb-4">
        <h2 class="fw-bold mb-1" style="color:#0a1f5c;">Edit Provider</h2>
        <p class="text-muted mb-0">Update provider information.</p>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius:18px;">
        <div class="card-body p-4 p-md-5">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="ProviderId" />

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ProviderName"
                           class="form-label fw-semibold"
                           style="color:#0a1f5c;">
                        Provider Name
                    </label>
                    <input asp-for="ProviderName"
                           class="form-control"
                           style="border-radius:10px;" />
                    <span asp-validation-for="ProviderName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email"
                           class="form-label fw-semibold"
                           style="color:#0a1f5c;">
                        Email
                    </label>
                    <input asp-for="Email"
                           class="form-control"
                           style="border-radius:10px;" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber"
                           class="form-label fw-semibold"
                           style="color:#0a1f5c;">
                        Phone Number
                    </label>
                    <input asp-for="PhoneNumber"
                           class="form-control"
                           style="border-radius:10px;" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address"
                           class="form-label fw-semibold"
                           style="color:#0a1f5c;">
                        Address
                    </label>
                    <input asp-for="Address"
                           class="form-control"
                           style="border-radius:10px;" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive"
                           class="form-check-input" />
                    <label asp-for="IsActive"
                           class="form-check-label fw-semibold"
                           style="color:#0a1f5c;">
                        Active
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn fw-semibold px-4 text-white"
                            style="background-color:#0a1f5c; border:none; border-radius:10px;">
                        Save Changes
                    </button>

                    <a asp-action="Index"
                       class="btn fw-semibold px-4"
                       style="border:1px solid #0a1f5c; color:#0a1f5c; border-radius:10px;">
                        Back
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}