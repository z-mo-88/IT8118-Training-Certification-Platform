@model IEnumerable<TrainingSystem.API.Models.Provider>

@{
    ViewData["Title"] = "Providers";
}

<div class="container-fluid py-5 px-3 px-md-5">

    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

        <div>

            <h2 class="fw-bold mb-1"
                style="color:#0a1f5c;">

                Providers

            </h2>

            <p class="text-muted mb-0">
                Manage equipment providers and supplier information.
            </p>

        </div>

        <div class="mt-3 mt-md-0">

            <a asp-action="Create"
               class="btn text-white fw-semibold px-4 d-flex align-items-center justify-content-center"
               style="background-color:#0a1f5c;
                      border-radius:10px;
                      border:none;
                      height:44px;
                      font-size:0.9rem;">

                Add Provider

            </a>

        </div>

    </div>

    <!-- SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4"
             style="border-radius:12px;">

            @TempData["Success"]

        </div>
    }

    <!-- CARD -->
    <div class="card border-0 shadow-sm"
         style="border-radius:18px; overflow:hidden;">

        <!-- TOP BAR -->
        <div class="px-4 py-3 text-white"
             style="background: linear-gradient(135deg, #0a1f5c, #123a9c);">

            <h5 class="fw-bold mb-1">
                Provider List
            </h5>

            <small class="text-white-50">
                Total Providers:
                @(Model?.Count() ?? 0)
            </small>

        </div>

        <!-- TABLE -->
        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle mb-0"
                       style="font-size:0.92rem;">

                    <thead style="background-color:rgba(10,31,92,0.06);">

                        <tr>

                            <th class="fw-bold small px-4 py-3"
                                style="color:#0a1f5c;">
                                Provider Name
                            </th>

                            <th class="fw-bold small py-3"
                                style="color:#0a1f5c;">
                                Email
                            </th>

                            <th class="fw-bold small py-3"
                                style="color:#0a1f5c;">
                                Phone Number
                            </th>

                            <th class="fw-bold small py-3"
                                style="color:#0a1f5c;">
                                Address
                            </th>

                            <th class="fw-bold small py-3"
                                style="color:#0a1f5c;">
                                Status
                            </th>

                            <th class="fw-bold small py-3 text-center"
                                style="color:#0a1f5c; width:220px;">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr style="vertical-align:middle;">

                                    <td class="px-4 py-3 fw-semibold small"
                                        style="color:#0a1f5c;">
                                        @item.ProviderName
                                    </td>

                                    <td class="py-3 text-muted small">
                                        @item.Email
                                    </td>

                                    <td class="py-3 text-muted small">
                                        @item.PhoneNumber
                                    </td>

                                    <td class="py-3 text-muted small">
                                        @item.Address
                                    </td>

                                    <td class="py-3">

                                        <span class="badge rounded-pill px-3 py-2 @(item.IsActive ? "bg-success" : "bg-secondary")"
                                              style="font-size:0.78rem;">

                                            @(item.IsActive ? "Active" : "Inactive")

                                        </span>

                                    </td>

                                    <td class="text-center py-3">

                                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                                            <a asp-action="Edit"
                                               asp-route-id="@item.ProviderId"
                                               class="btn btn-sm fw-semibold px-3 text-white"
                                               style="background-color:#0a1f5c;
                                                              border-radius:10px;
                                                              border:none;
                                                              min-width:90px;
                                                              font-size:0.78rem;">

                                                Edit

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.ProviderId"
                                               class="btn btn-sm fw-semibold px-3 text-white"
                                               style="background-color:#dc3545;
                                                              border-radius:10px;
                                                              border:none;
                                                              min-width:90px;
                                                              font-size:0.78rem;">

                                                Delete

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center text-muted py-5">

                                    No providers found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>