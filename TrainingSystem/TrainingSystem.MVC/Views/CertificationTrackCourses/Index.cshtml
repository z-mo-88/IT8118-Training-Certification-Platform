<div class="container-fluid py-5 px-3 px-md-5">

    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

        <div>
            <h3 class="fw-bold mb-1"
                style="color:#0a1f5c;">
                Track Courses
            </h3>

            <p class="text-muted mb-0">
                Manage courses assigned to certification tracks.
            </p>
        </div>

        <div class="mt-3 mt-md-0">

            <a asp-action="Create"
               class="btn text-white fw-semibold px-4 d-inline-flex align-items-center justify-content-center shadow-sm"
               style="background-color:#0a1f5c;
                      border-radius:12px;
                      border:none;
                      height:46px;
                      font-size:0.9rem;">

                + Assign Course

            </a>

        </div>

    </div>

    <!-- SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4"
             style="border-radius:14px;">

            @TempData["Success"]

        </div>
    }

    <!-- CARD -->
    <div class="card border-0 shadow-sm"
         style="border-radius:22px;
                overflow:hidden;">

        <!-- TOP BAR -->
        <div class="px-4 py-3 text-white"
             style="background: linear-gradient(135deg, #0a1f5c, #163d99);">

            <h5 class="fw-bold mb-1">
                Assigned Courses
            </h5>

            <small class="text-white-50">
                Total Records:
                @(Model?.Count ?? 0)
            </small>

        </div>

        <!-- BODY -->
        <div class="card-body p-4">

            @foreach (var item in Model)
            {
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-3 p-3"
                     style="border:1px solid rgba(10,31,92,0.08);
                                border-radius:16px;
                                background-color:#fbfcff;">

                    <!-- LEFT -->
                    <div>

                        <div class="fw-semibold mb-1"
                             style="color:#0a1f5c;
                                        font-size:0.95rem;">

                            @item.CertificationTrack.TrackName

                        </div>

                        <div class="text-muted"
                             style="font-size:0.88rem;">

                            @item.Course.Title

                        </div>

                    </div>

                    <!-- RIGHT -->
                    <div class="d-flex align-items-center gap-3 flex-wrap">

                        <!-- BADGE -->
                        <span class="badge px-3 py-2"
                              style="background:@(item.IsRequired ? "#198754" : "#6c757d");
                                         border-radius:999px;
                                         font-size:0.72rem;">

                            @(item.IsRequired ? "Required" : "Optional")

                        </span>

                        <!-- BUTTONS -->
                        <div class="d-flex gap-2">

                            <a asp-action="Edit"
                               asp-route-trackId="@item.CertificationTrackId"
                               asp-route-courseId="@item.CourseId"
                               class="btn btn-sm fw-semibold"
                               style="background:#ffc107;
                                          border-radius:10px;
                                          min-width:75px;
                                          font-size:0.76rem;">

                                Edit

                            </a>

                            <a asp-action="Delete"
                               asp-route-trackId="@item.CertificationTrackId"
                               asp-route-courseId="@item.CourseId"
                               class="btn btn-sm text-white fw-semibold"
                               style="background:#dc3545;
                                          border-radius:10px;
                                          min-width:75px;
                                          font-size:0.76rem;">

                                Delete

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</div>