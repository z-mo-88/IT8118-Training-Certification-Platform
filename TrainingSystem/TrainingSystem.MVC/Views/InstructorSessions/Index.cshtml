@model IEnumerable<TrainingSystem.API.Models.CourseSession>

@{
    ViewData["Title"] = "My Sessions";
}

<div class="container-fluid py-5 px-3 px-md-5"
     style="background-color:#f6f8fc; min-height:100vh;">

    <!-- HEADER -->
    <div class="mb-4">

        <h2 class="fw-bold mb-1"
            style="color:#0a1f5c;">

            My Sessions

        </h2>

        <p class="text-muted mb-0">
            View your assigned course sessions.
        </p>

    </div>

    <!-- CARD -->
    <div class="card border-0 shadow-sm"
         style="border-radius:22px;
                overflow:hidden;
                background-color:white;">

        <!-- TOP BAR -->
        <div class="px-4 py-3 text-white"
             style="background: linear-gradient(135deg, #0a1f5c, #163d99);">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <div>

                    <h5 class="fw-bold mb-1">
                        Session Schedule
                    </h5>

                    <small class="text-white-50">
                        Total Sessions:
                        @(Model?.Count() ?? 0)
                    </small>

                </div>

            </div>

        </div>

        <!-- TABLE -->
        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle mb-0"
                       style="font-size:0.92rem;">

                    <thead style="background-color:rgba(10,31,92,0.05);">

                        <tr>

                            <th class="fw-bold px-4 py-3"
                                style="color:#0a1f5c;">
                                Course
                            </th>

                            <th class="fw-bold py-3"
                                style="color:#0a1f5c;">
                                Room
                            </th>

                            <th class="fw-bold py-3"
                                style="color:#0a1f5c;">
                                Date
                            </th>

                            <th class="fw-bold py-3"
                                style="color:#0a1f5c;">
                                Time
                            </th>

                            <th class="fw-bold py-3 text-center"
                                style="color:#0a1f5c;">
                                Status
                            </th>

                            <th class="fw-bold py-3 text-center"
                                style="color:#0a1f5c;">
                                Available Seats
                            </th>

                            <th class="fw-bold py-3 text-center"
                                style="color:#0a1f5c; width:220px;">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr style="vertical-align:middle;">

                                    <!-- COURSE -->
                                    <td class="px-4 py-3 fw-semibold"
                                        style="color:#0a1f5c;">

                                        @item.Course?.Title

                                    </td>

                                    <!-- ROOM -->
                                    <td class="py-3 text-muted">

                                        @item.Room?.RoomName

                                    </td>

                                    <!-- DATE -->
                                    <td class="py-3 text-muted">

                                        @item.SessionDate.ToShortDateString()

                                    </td>

                                    <!-- TIME -->
                                    <td class="py-3 text-muted">

                                        @item.StartTime - @item.EndTime

                                    </td>

                                    <!-- STATUS -->
                                    <td class="py-3 text-center">

                                        <span class="badge rounded-pill px-3 py-2"
                                              style="background-color:rgba(10,31,92,0.08);
                                                             color:#0a1f5c;
                                                             font-size:0.75rem;
                                                             font-weight:600;">

                                            @item.Status

                                        </span>

                                    </td>

                                    <!-- AVAILABLE SEATS -->
                                    <td class="py-3 text-center fw-bold"
                                        style="color:#0a1f5c;">

                                        <span id="seats-@item.SessionId">

                                            @item.AvailableSeats

                                        </span>

                                    </td>

                                    <!-- ACTIONS -->
                                    <td class="text-center py-3">

                                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                                            <a asp-action="Details"
                                               asp-route-id="@item.SessionId"
                                               class="btn btn-sm fw-semibold px-3 text-white"
                                               style="background-color:#0a1f5c;
                                                              border-radius:10px;
                                                              border:none;
                                                              min-width:85px;
                                                              font-size:0.78rem;">

                                                Details

                                            </a>

                                            <a asp-action="Students"
                                               asp-route-id="@item.SessionId"
                                               class="btn btn-sm fw-semibold px-3 text-white"
                                               style="background-color:#198754;
                                                              border-radius:10px;
                                                              border:none;
                                                              min-width:90px;
                                                              font-size:0.78rem;">

                                                Students

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center text-muted py-5">

                                    No sessions found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/enrollmentHub")
        .build();

    connection.on("EnrollmentUpdated", function (sessionId, availableSeats) {

        const element = document.getElementById("seats-" + sessionId);

        if (element) {
            element.innerText = availableSeats;
        }
    });

    connection.start()
        .catch(err => console.error(err.toString()));
</script>