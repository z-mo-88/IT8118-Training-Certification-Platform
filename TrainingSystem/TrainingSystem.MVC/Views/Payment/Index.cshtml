@model IEnumerable<TrainingSystem.API.Models.Payment>

@{
    ViewData["Title"] = "Payments";

    var groupedPayments = Model?
        .Where(p => p.Enrollment?.User != null)
        .GroupBy(p => new
        {
            UserId = p.Enrollment!.User!.UserId,
            Name = p.Enrollment.User.Name,
            CPR = p.Enrollment.User.CPR,
            Email = p.Enrollment.User.Email
        })
        .OrderBy(g => g.Key.UserId)
        .ToList();
}

<div class="container-fluid py-5 px-3 px-md-5"
     style="background-color:#f6f8fc; min-height:100vh;">

    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

        <div>

            <h2 class="fw-bold mb-1"
                style="color:#0a1f5c;">

                Payments

            </h2>

            <p class="text-muted mb-0">
                Manage trainee payments and remaining balances.
            </p>

        </div>

        <div class="mt-3 mt-md-0">

            <a asp-action="Create"
               class="btn text-white fw-semibold px-4 d-inline-flex align-items-center justify-content-center shadow-sm"
               style="background-color:#0a1f5c;
                      border-radius:12px;
                      border:none;
                      height:46px;
                      font-size:0.9rem;">

                Record Payment

            </a>

        </div>

    </div>

    <!-- SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4"
             style="border-radius:14px;">

            @TempData["Success"]

        </div>
    }

    <!-- PAYMENT CARDS -->
    @if (groupedPayments != null && groupedPayments.Any())
    {
        @foreach (var userGroup in groupedPayments)
        {
            <div class="card border-0 shadow-sm mb-4"
                 style="border-radius:22px;
                                overflow:hidden;
                                background-color:white;">

                <!-- TOP SECTION -->
                <div class="p-4 text-white"
                     style="background: linear-gradient(135deg, #0a1f5c, #163d99);">

                    <div class="d-flex flex-column gap-3">

                        <!-- NAME -->
                        <div>

                            <div class="text-white-50 mb-1"
                                 style="font-size:0.9rem;">

                                Trainee

                            </div>

                            <h3 class="fw-bold mb-2">

                                @userGroup.Key.Name

                            </h3>

                            <!-- USER INFO -->
                            <div class="d-flex flex-wrap gap-4 small">

                                <div>

                                    <span class="text-white-50">
                                        User ID:
                                    </span>

                                    <span class="fw-semibold">
                                        @userGroup.Key.UserId
                                    </span>

                                </div>

                                <div>

                                    <span class="text-white-50">
                                        CPR:
                                    </span>

                                    <span class="fw-semibold">
                                        @userGroup.Key.CPR
                                    </span>

                                </div>

                                <div>

                                    <span class="text-white-50">
                                        Email:
                                    </span>

                                    <span class="fw-semibold">
                                        @userGroup.Key.Email
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- TABLE -->
                <div class="table-responsive">

                    <table class="table align-middle mb-0"
                           style="font-size:0.93rem;">

                        <thead style="background-color:#f8faff;">

                            <tr>

                                <th class="px-4 py-3 fw-bold"
                                    style="color:#0a1f5c;">
                                    Course
                                </th>

                                <th class="text-center fw-bold"
                                    style="color:#0a1f5c;">
                                    Paid
                                </th>

                                <th class="text-center fw-bold"
                                    style="color:#0a1f5c;">
                                    Remaining
                                </th>

                                <th class="text-center fw-bold"
                                    style="color:#0a1f5c;">
                                    Overdue
                                </th>

                                <th class="text-center fw-bold"
                                    style="color:#0a1f5c;">
                                    Status
                                </th>

                                <th class="text-center fw-bold"
                                    style="color:#0a1f5c;">
                                    Date
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in userGroup.OrderByDescending(p => p.PaidDate))
                            {
                                var remainingBalance =
                                item.Enrollment?.OutstandingBalance ?? 0m;

                                var displayStatus =
                                remainingBalance <= 0
                                ? "Paid"
                                : "Partial";

                                <tr style="vertical-align:middle;">

                                    <!-- COURSE -->
                                    <td class="px-4 py-3">

                                        <div class="fw-semibold"
                                             style="color:#0a1f5c;">

                                            @item.Enrollment?.Session?.Course?.Title

                                        </div>

                                    </td>

                                    <!-- PAID -->
                                    <td class="text-center py-3 fw-semibold"
                                        style="color:#0a1f5c;">

                                        @item.AmountPaid BD

                                    </td>

                                    <!-- REMAINING -->
                                    <td class="text-center py-3 fw-bold"
                                        style="color:@(remainingBalance > 0 ? "#dc3545" : "#198754")">

                                        @remainingBalance BD

                                    </td>

                                    <!-- OVERDUE -->
                                    <td class="text-center py-3">

                                        @if (item.Enrollment?.IsOverdue == true)
                                        {
                                            <span class="badge px-3 py-2"
                                                  style="background-color:#ffe5e5;
                                                                         color:#dc3545;
                                                                         border-radius:999px;
                                                                         font-size:0.72rem;">

                                                Overdue

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>

                                    <!-- STATUS -->
                                    <td class="text-center py-3">

                                        @if (displayStatus == "Paid")
                                        {
                                            <span class="badge px-3 py-2"
                                                  style="background-color:#e7f8ee;
                                                                         color:#198754;
                                                                         border-radius:999px;
                                                                         font-size:0.72rem;">

                                                Paid

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge px-3 py-2"
                                                  style="background-color:#fff3cd;
                                                                         color:#856404;
                                                                         border-radius:999px;
                                                                         font-size:0.72rem;">

                                                Partial

                                            </span>
                                        }

                                    </td>

                                    <!-- DATE -->
                                    <td class="text-center py-3 text-muted small">

                                        @item.PaidDate

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }
    }
    else
    {
        <div class="card border-0 shadow-sm"
             style="border-radius:20px;">

            <div class="card-body text-center py-5 text-muted">

                No payments found.

            </div>

        </div>
    }

</div>